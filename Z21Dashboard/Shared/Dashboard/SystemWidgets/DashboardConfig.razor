@*
    A settings component that allows the user to toggle the visibility
    of individual dashboard components and change global settings.
*@
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Localization
@using Z21Dashboard.Application.Interfaces
@using Z21Dashboard.Application.Models
@using Z21Dashboard.Shared.Dashboard.Components
@inject IDashboardStateService DashboardStateService
@inject IFileAndFolderService FolderPickerService
@inject IStringLocalizer<DashboardConfigResources> Localizer
@implements IDisposable

<div class="card shadow-sm">
    <div class="card-body">
        <TabControl>
            <TabPage Title="@Localizer["WidgetsTab"]">
                <p class="card-text text-muted">@Localizer["WidgetInfoText"]</p>

                @if (_allComponents.Any())
                {
                    <ul class="list-group">
                        @foreach (var componentState in _allComponents)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span>@componentState.Name</span>

                                @* Visibility Toggle Switch *@
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch"
                                           checked="@componentState.IsVisible"
                                           onchange="@(async () => await DashboardStateService.ToggleVisibility(componentState.Id))" />
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p>@Localizer["NoWidgets"]</p>
                }
            </TabPage>
            <TabPage Title="@Localizer["SettingsTab"]">
                <p class="card-text text-muted">@Localizer["SettingsInfoText"]</p>

                @if (_settingsMessage is not null)
                {
                    <div class="alert alert-info" role="alert">
                        @_settingsMessage
                    </div>
                }

                @if (_errorMessage is not null)
                {
                    <div class="alert alert-danger py-2 mb-3">
                        @_errorMessage
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label fw-bold">@Localizer["Scale"]</label>
                    <select class="form-select" @bind="_dashboardSettings.Scale">
                        @foreach (var scale in Enum.GetValues<ModelScale>())
                        {
                            <option value="@scale">@scale.ToString() (1:@((int)scale))</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">@Localizer["TempScale"]</label>
                    <select class="form-select" @bind="_dashboardSettings.TemperatureScale">
                        @foreach (var tempScale in Enum.GetValues<TemperatureScale>())
                        {
                            <option value="@tempScale">@Localizer[tempScale.ToString()]</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">@Localizer["LocalDecoderFolder"]</label>
                    <div class="input-group">
                        <div class="form-control">
                            @if (_dashboardSettings.LocalLocoDecoderFolder is null)
                            {
                                <text><span style="color: #aaa;">Ingen folder valgt</span></text>
                            }
                            else
                            {
                                @_dashboardSettings.LocalLocoDecoderFolder
                            }
                        </div>
                        <button class="btn btn-outline-secondary" @onclick="@(async (e) => await SelectFolderDecoder(e))">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                                <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                            </svg>
                        </button>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">@Localizer["LocalLocomotiveFolder"]</label>
                    <div class="input-group">
                        <div class="form-control">
                            @if (_dashboardSettings.LocalLocomotiveFolder is null)
                            {
                                <text><span style="color: #aaa;">Ingen folder valgt</span></text>
                            }
                            else
                            {
                                @_dashboardSettings.LocalLocomotiveFolder
                            }
                        </div>
                        <button class="btn btn-outline-secondary" @onclick="@(async (e) => await SelectFolderLocomotive(e))">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                                <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                            </svg>
                        </button>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" @onclick="@(async () => await RereadSettings())">@Localizer["Reread"]</button>
                    <button type="button" class="btn btn-primary" @onclick="@(async () => await SaveSettings())">@Localizer["Save"]</button>
                </div>

            </TabPage>
        </TabControl>
    </div>
</div>

@code {
    private List<DashboardComponentState> _allComponents = new();
    private DashboardSettings _dashboardSettings = new();

    private string? _errorMessage;
    private string? _settingsMessage;

    protected async override Task OnInitializedAsync()
    {
        DashboardStateService.OnLayoutChanged += OnLayoutChanged;
        LoadComponentList();
        _dashboardSettings = await DashboardStateService.GetSettings();
    }

    private void LoadComponentList()
    {
        _allComponents = DashboardStateService.GetUserSelectableComponents();
    }

    private async void OnLayoutChanged()
    {
        await InvokeAsync(() =>
        {
            LoadComponentList();
            StateHasChanged();
        });
    }

    public async Task RereadSettings()
    {
        _dashboardSettings = await DashboardStateService.GetSettings();
        _settingsMessage = Localizer["SettingsRereadMessage"];
    }

    public async Task SaveSettings()
    {
        _errorMessage = null;
        _settingsMessage = null;

        if (_dashboardSettings.LocalLocoDecoderFolder is not null &&
            _dashboardSettings.LocalLocomotiveFolder is not null &&
            _dashboardSettings.LocalLocoDecoderFolder == _dashboardSettings.LocalLocomotiveFolder)
        {
            _errorMessage = Localizer["PathsCannotBeEqual"];
            return;
        }

        await DashboardStateService.SaveSettings(_dashboardSettings);
        _settingsMessage = Localizer["SettingsSavedMessage"];
    }

    public void Dispose()
    {
        DashboardStateService.OnLayoutChanged -= OnLayoutChanged;
    }

    private void OnUnitSystemChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<MeasurementUnitSystem>(e.Value?.ToString(), out var newSystem))
        {
            _dashboardSettings.UnitSystem = newSystem;
        }
    }

    private async Task SelectFolderDecoder(MouseEventArgs args)
    {
        var selectedFolder = await FolderPickerService.PickFolderAsync();
        if (selectedFolder is not null)
        {
            _dashboardSettings.LocalLocoDecoderFolder = selectedFolder;
        }
    }

    private async Task SelectFolderLocomotive(MouseEventArgs args)
    {
        var selectedFolder = await FolderPickerService.PickFolderAsync();
        if (selectedFolder is not null)
        {
            _dashboardSettings.LocalLocomotiveFolder = selectedFolder;
        }
    }

}
