@*
   TabControl.razor
*@
@using Microsoft.Extensions.Localization
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject IStringLocalizer<TabControlResource> Localizer

<div class="tabs-container">

    <div class="tabs-header">
        <div class="tabs-scroll" @ref="TabsScrollRef">

            <ul class="nav-tabs">
                @foreach (var onePage in Pages)
                {
                    <li class="@(ActivePage == onePage ? "active" : string.Empty)"
                        onclick="@(() => ActivatePage(onePage))">
                        @onePage.Title
                    </li>
                }
            </ul>
        </div>

        <button class="scroll-btn right" type="button" style="display:@(ShowScrollButtons ? "inline-block" : "none")" onclick="@ScrollLeft" title="@Localizer["ToolTipLeft"]">
            &#9664;
        </button>
        <button class="scroll-btn right" type="button" style="display:@(ShowScrollButtons ? "inline-block" : "none")" onclick="@ScrollRight" title="@Localizer["ToolTipRight"]">
            &#9654;
        </button>
    </div>

    <div class="tab-content">
        <CascadingValue Value="this">
            @ChildContent
        </CascadingValue>
    </div>
</div>

<script>
    window.tabControlScroll = window.tabControlScroll || {};
    window.tabControlScroll.scrollBy = function (element, amount) {
        if (!element) return;
        element.scrollBy({ left: amount, behavior: 'smooth' });
    };

    window.tabControlScroll.isOverflowing = function (scrollElement) {
        if (!scrollElement) return false;
        return scrollElement.scrollWidth > scrollElement.clientWidth;
    };
</script>

@code {
    [Parameter]
    public required RenderFragment ChildContent { get; set; }

    [Parameter]
    public EventCallback<ushort>? OnPageChange { get; set; }

    public TabPage? ActivePage { get; set; }
    private List<TabPage> Pages = new List<TabPage>();

    private bool ShowScrollButtons = false;

    private ElementReference TabsScrollRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (Pages.Count > 0)
            {
                ShowScrollButtons = await JS.InvokeAsync<bool>("tabControlScroll.isOverflowing", TabsScrollRef);
                StateHasChanged();
            }
        }
    }


    private async Task ScrollLeft()
    {
        await JS.InvokeVoidAsync("tabControlScroll.scrollBy", TabsScrollRef, -150);
    }

    private async Task ScrollRight()
    {
        await JS.InvokeVoidAsync("tabControlScroll.scrollBy", TabsScrollRef, 150);
    }

    public void AddPage(TabPage page)
    {
        Pages.Add(page);
        if (Pages.Count == 1)
        {
            ActivePage = page;
        }
        StateHasChanged();
    }

    private void ActivatePage(TabPage page)
    {
        ActivePage = page;

        // Find the number of the page
        var index = Pages.FindIndex(p => p == page);
        OnPageChange?.InvokeAsync((ushort)index);

        StateHasChanged();
    }
}