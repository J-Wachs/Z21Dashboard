@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Localization
@inherits InputBase<byte?>
@inject IStringLocalizer<InputNumericValueResources> Localizer

<input type="number" class="@CssClass" @bind="CurrentValueAsString" @bind:event="oninput" />

@code {
    [Parameter]
    public ushort? Min { get; set; }

    [Parameter]
    public ushort? Max { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        // Make sure that the Min/Max contains reasonble values.
        if (Min is null)
        {
            Min = 0;
        }

        if (Max is null)
        {
            Max = 255;
        }
    }

    // Denne bliver nu kaldt HVER gang brugeren trykker på en tast (pga. oninput)
    protected override bool TryParseValueFromString(string? value, out byte? result, out string validationErrorMessage)
    {
        // 1. Tjek om det er et tal
        if (byte.TryParse(value, out var tempResult))
        {
            // 2. Tjek om det er inden for dine grænser (Min/Max)
            if (tempResult < Min || tempResult > Max)
            {
                validationErrorMessage = string.Format(Localizer["ValueMustBeInRange"], Min, Max);
                result = tempResult;
                return false;
            }

            validationErrorMessage = string.Empty;
            result = tempResult;
            return true;
        }
        else
        {
            validationErrorMessage = string.Format(Localizer["ValueMustBeInRange"], Min, Max);
            result = null;
            return false;
        }
    }
}
