@*
    InputCVBitFlag.razor
    Lets the user set a single bit in a CV to true/false or leave it unchanged (null).
*@
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Localization
@using Z21Dashboard.Application.Models
@inject IStringLocalizer<InputCVBitFlagResources> Localizer

@* We handle CSS validation classes manually via EditContext *@
<select class="@ComputedCssClass" @onchange="OnSelectionChanged" value="@CurrentValueAsString">
    <option value="">@_optionNullText</option>
    <option value="False">@_optionFalseText</option>
    <option value="True">@_optionTrueText</option>
</select>

@code {
    // We retrieve the EditContext to be able to style the field red/green if necessary (optional)
    [CascadingParameter]
    private EditContext? CascadedEditContext { get; set; }

    [Parameter, EditorRequired]
    public ushort CV { get; set; }

    // Manual Two-way binding
    [Parameter]
    public bool? Value { get; set; }

    [Parameter]
    public EventCallback<bool?> ValueChanged { get; set; }

    [Parameter]
    public CvBitInformation? Metadata { get; set; }

    [Parameter]
    public string CssClass { get; set; } = "form-control";


    private string _optionTrueText = "On";
    private string _optionFalseText = "Off";
    private string _optionNullText = "NoChange";

    // Calculate CSS classes based on validation status (if we want to keep the visual)
    private string ComputedCssClass
    {
        get
        {
            var classes = CssClass;
            if (CascadedEditContext is not null)
            {
                // Since we don't have a FieldIdentifier for an array index, we use a simple check
                // Or we can just return the base class, as bits rarely fail validation.
                if (CascadedEditContext.IsModified()) classes += " modified";
            }
            return classes;
        }
    }

    private string CurrentValueAsString => Value.HasValue ? Value.Value.ToString() : string.Empty;

    protected override void OnParametersSet()
    {
        // Logic for the text
        _optionNullText = Localizer["NoChange"];

        if (Metadata is not null)
        {
            _optionTrueText = Metadata.OnLabel;
            _optionFalseText = Metadata.OffLabel;
        }
    }

    private async Task OnSelectionChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        bool? newValue = val switch
        {
            "True" => true,
            "False" => false,
            _ => null
        };

        if (newValue != Value)
        {
            Value = newValue;
            await ValueChanged.InvokeAsync(newValue);

            // Inform the EditContext that the value is changed
            CascadedEditContext?.NotifyFieldChanged(new FieldIdentifier(CascadedEditContext.Model, string.Empty));
        }
    }
}
