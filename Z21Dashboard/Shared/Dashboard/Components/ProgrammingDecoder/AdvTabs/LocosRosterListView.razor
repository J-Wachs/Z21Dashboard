@*
    Locomotives.razor
*@
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Logging
@using Microsoft.JSInterop
@using Microsoft.Maui.Controls
@using Z21Dashboard.Application.Interfaces
@using Z21Dashboard.Application.Models
@inject IDashboardStateService DashboardStateService
@inject IDecoderUIPageBuilder DecoderUIPageBuilder
@inject IDecoderDefinitionService DecoderDefinitionService
@inject IDecoderProgHelperService DecoderProgHelperService
@inject IFileAndFolderService FileAndFolderService
@inject IJSRuntime JSRuntime
@inject ILocoDefinitionService LocoDefinitionService
@inject ILogger<Identify> Logger
@inject IStringLocalizer<LocosRosterListViewResource> Localizer

<div class="row">
    <div class="col-12">
        <DataGrid TItem="LocomotiveListItemDto"
                  Items="@_locomotivesList"
                  Columns="@_locoColumns"
                  @bind-SelectedItem="@_selectedLocomotive"
                  OnRowClicked="@OnLocomotiveRowClicked"
                  EmptyMessage="No locomotives found in C:\Trains"
                  ShowSearch="true"
                  SearchPlaceholder="Search by name, manufacturer, class..."
                  SearchSelectors="@_searchSelectors" />
    </div>
</div>

<div class="row">
    <div class="col-12 d-flex justify-content-end gap-2">
        @if (string.IsNullOrEmpty(_dashboardSettings.LocalLocomotiveFolder) is false)
        {
            <button type="button" class="btn btn-primary"
                    @onclick="@(async () => await OnAddNewLoco())" title="Add New Locomotive">
                @Localizer["AddNew"]
            </button>
            <button type="button" class="btn btn-primary" disabled="@_buttonsDisabled"
                    @onclick="@(async () => await SaveSelectedDecoderAsLocal())" aria-label="ReadCV">
                @Localizer["Copy"]
            </button>
            <button type="button" class="btn btn-primary" disabled="@_buttonsDisabled"
                    @onclick="@(async () => await LoadAndSetupForDecoder())" aria-label="ReadCV">
                @Localizer["Edit"]
            </button>
            <button type="button" class="btn btn-primary" disabled="@_buttonsDisabled"
                    @onclick="@(async () => await LoadAndSetupForDecoder())" aria-label="ReadCV">
                @Localizer["Delete"]
            </button>
            <button type="button" class="btn btn-primary" disabled="@_buttonsDisabled"
                    @onclick="@(async () => await LoadAndSetupForDecoder())" aria-label="ReadCV">
                @Localizer["ReadIn"]
            </button>
        }
    </div>
</div>

@* Add/Edit Locomotive Modal *@
<DraggableModal IsOpen="@_showAddLocomotiveModal"
                Title="@(_isEditMode ? $"Edit Locomotive - {_newLocomotive?.Meta?.Name}" : "Add New Locomotive")"
                Size="DraggableModal.ModalSize.Large"
                OnClose="@CancelAddLocomotive">
    <ChildContent>
        @if (_newLocomotive?.Meta is not null)
        {
            <div class="locomotive-form">
                <div class="mb-3">
                    <label for="name" class="form-label">Name *</label>
                    <input id="name" type="text" class="form-control" @bind="_newLocomotive.Meta.Name" placeholder="e.g., Express Engine #42" />
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="shortName" class="form-label">Short name</label>
                            <input id="shortName" type="text" class="form-control" @bind="_newLocomotive.Meta.ShortName" placeholder="e.g., EX42" maxlength="20" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="manufacturer" class="form-label">Manufacturer</label>
                            <input id="manufacturer" type="text" class="form-control" @bind="_newLocomotive.Meta.Manufacturer" placeholder="e.g., Kato" />
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="class" class="form-label">Class</label>
                            <input id="class" type="text" class="form-control" @bind="_newLocomotive.Meta.Class" placeholder="e.g., A4" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="unitNumber" class="form-label">Unit Number</label>
                            <input id="unitNumber" type="text" class="form-control" @bind="_newLocomotive.Meta.UnitNumber" placeholder="e.g., 4468" />
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="catalogueNumber" class="form-label">Catalogue Number</label>
                    <input id="catalogueNumber" type="text" class="form-control" @bind="_newLocomotive.Meta.CatalogueNumber" placeholder="e.g., 700-1201" />
                </div>

                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <textarea id="description" class="form-control" @bind="_newLocomotive.Meta.Description" placeholder="Detailed description..." rows="3"></textarea>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="purchased" class="form-label">Purchased</label>
                            <input id="purchased" type="date" class="form-control" @bind="_newLocomotive.Meta.Purchased" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="purchasePrice" class="form-label">Purchase Price</label>
                            <input id="purchasePrice" type="number" step="0.01" class="form-control" @bind="_newLocomotive.Meta.PurchasePrice" placeholder="0.00" />
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="remarks" class="form-label">Remarks</label>
                    <textarea id="remarks" class="form-control" @bind="_newLocomotive.Meta.Remarks" placeholder="Any remarks..." rows="2"></textarea>
                </div>

                <div class="mb-3">
                    <label for="modifications" class="form-label">Modifications</label>
                    <textarea id="modifications" class="form-control" @bind="_newLocomotive.Meta.Modifications" placeholder="List of modifications..." rows="2"></textarea>
                </div>
            </div>
        }
    </ChildContent>
    <FooterContent>
        <button type="button" class="btn btn-primary" @onclick="@SaveNewLocomotiveClick">Save</button>
        <button type="button" class="btn btn-secondary" @onclick="@CancelAddLocomotive">Cancel</button>
    </FooterContent>
</DraggableModal>

@code {
    [CascadingParameter]
    public required TabControl Parent { get; set; }

    [CascadingParameter]
    public required ProgrammingTargetAddr ProgTargetAddr { get; set; }

    [CascadingParameter]
    public required DecoderSettings DecoderSettings { get; set; }

    [Parameter, EditorRequired]
    public required List<string> ErrorMessages { get; set; }

    [Parameter]
    public EventCallback<List<string>> ErrorMessagesChanged { get; set; }

    [Parameter, EditorRequired]
    public string? WorkingMessage { get; set; }

    [Parameter]
    public EventCallback<string?> WorkingMessageChanged { get; set; }

    [Parameter, EditorRequired]
    public string? SuccessMessage { get; set; }

    [Parameter]
    public EventCallback<string?> SuccessMessageChanged { get; set; }


    private List<DecoderListItemDto> _listOfLocoDecoders = [];
    private DecoderListItemDto? _selectedFile = null;
    private bool _buttonsDisabled = true;
    private DashboardSettings _dashboardSettings = new();

    private List<LocomotiveListItemDto> _locomotivesList = [];
    private string _locomotivesDirectory = string.Empty;
    private LocomotiveListItemDto? _selectedLocomotive = null;
    private List<ColumnDefinition<LocomotiveListItemDto>>? _locoColumns = null;
    private Func<LocomotiveListItemDto, string>[]? _searchSelectors = null;

    // Modal state variables
    private bool _showAddLocomotiveModal = false;
    private LocomotiveDefinitionDto? _newLocomotive = null;
    private bool _isEditMode = false;
    private string _editingFilePath = string.Empty;


    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        _dashboardSettings = await GetSettingsAsync();

        _locomotivesDirectory = _dashboardSettings.LocalLocomotiveFolder ?? string.Empty;

        InitializeColumns();

        await LoadLocomotivesFromFilesAsync();

        await GetAvailableDecodersAsync();
        if (await SetSelectedDecoderFile())
        {
            await LoadSelectedDecoderFile();
        }
        else
        {
            await SetupTabs();
            StateHasChanged();
        }
    }

    /// <summary>
    /// Get decoders and populate list.
    /// </summary>
    /// <returns></returns>
    private async Task GetAvailableDecodersAsync()
    {
        var resultListOfLocoDecoders = await DecoderDefinitionService.GetLocoDecodersAsync();
        if (resultListOfLocoDecoders.IsSuccess is false)
        {
            List<string> lstErrorMessages = [];
            foreach (var errorMessageForField in resultListOfLocoDecoders.Messages)
            {
                lstErrorMessages.AddRange(errorMessageForField.Messages);
            }
            await ErrorMessagesChanged.InvokeAsync(ErrorMessages);
        }
        else
        {
            var listOfLocoDecoders = resultListOfLocoDecoders.Data;

            _listOfLocoDecoders.Clear();
            if (listOfLocoDecoders is not null)
            {
                foreach (var oneDecoder in listOfLocoDecoders)
                {
                    _listOfLocoDecoders.Add(new(
                        Name: oneDecoder.Name + $" ({(oneDecoder.Location is DecoderFileLocation.LocalStorage ? Localizer["UserDef"] : Localizer["SystemDef"])})",
                        FileName: oneDecoder.FileName,
                        Manufacturer: oneDecoder.Manufacturer,
                        Location: oneDecoder.Location
                    ));
                }
            }
        }
    }

    /// <summary>
    /// Initialize the data grid columns for locomotives display.
    /// </summary>
    private void InitializeColumns()
    {
        _locoColumns = new List<ColumnDefinition<LocomotiveListItemDto>>
        {
            new()
            {
                Header ="Address",
                ValueSelector = l => l.Address,
                Width = "50px"
            },
            new()
            {
                Header = "Name",
                ValueSelector = l => l.Name,
                Width = "200px"
            },
            new()
            {
                Header = "Short",
                ValueSelector = l => l.ShortName ?? string.Empty,
                Width = "100px"
            },
            new()
            {
                Header = "Manufacturer",
                ValueSelector = l => l.Manufacturer ?? string.Empty,
                Width = "120px"
            },
            new()
            {
                Header = "Class",
                ValueSelector = l => l.Class ?? string.Empty,
                Width = "100px"
            },
            new()
            {
                Header = "Unit Number",
                ValueSelector = l => l.UnitNumber ?? string.Empty,
                Width = "120px"
            }
        };

        // Initialize search selectors - these define which fields are searchable
        _searchSelectors = new Func<LocomotiveListItemDto, string>[]
        {
            l => l.Address.ToString(),
            l => l.Name ?? string.Empty,                    // Search by locomotive name
            l => l.ShortName ?? string.Empty,               // Search by short name
            l => l.Manufacturer ?? string.Empty,            // Search by manufacturer
            l => l.Class ?? string.Empty,                   // Search by class
            l => l.UnitNumber ?? string.Empty               // Search by unit number
        };
    }

    /// <summary>
    /// Handle row click event in the locomotive grid.
    /// </summary>
    private async Task OnLocomotiveRowClicked(LocomotiveListItemDto locomotive)
    {
        //_selectedLocomotive = locomotive;
        _buttonsDisabled = false;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Load locomotive definitions from JSON files in the C:\Trains directory.
    /// </summary>
    private async Task LoadLocomotivesFromFilesAsync()
    {

        var result = await LocoDefinitionService.GetLocomotivesAsync();
        if (result.IsSuccess is false)
        {
            if (result.Messages.Count > 0)
            {
                List<string> lstErrorMessages = [];
                foreach (var fileMessages in result.Messages)
                {
                    lstErrorMessages.AddRange(fileMessages.Messages);
                }
                ErrorMessages = lstErrorMessages;
                await ErrorMessagesChanged.InvokeAsync(ErrorMessages);
            }
        }
        else
        {
            _locomotivesList = [.. result.Data!];
        }
    }

    /// <summary>
    /// Set the selected decoder file based on the DecoderSettings.
    /// If a selected decoder file is specified in the DecoderSettings
    /// then that file will be selected, otherwise the standard NMRA decoder will be selected by default.
    /// </summary>
    /// <returns>false: Specific decoder file was previously selected, so do not override 'DecoderSettings'.</returns>
    private async Task<bool> SetSelectedDecoderFile()
    {
        // If a selected decoder exists then select that one
        if (string.IsNullOrEmpty(DecoderSettings.DecoderFile) is false)
        {
            _selectedFile = new(
                FileName: DecoderSettings.DecoderFile,
                Name: DecoderSettings.DecoderName!,
                Manufacturer: DecoderSettings.DecoderMfg!,
                Location: DecoderSettings.DecoderFileLocation!.Value
                );
            return false;
        }
        else
        {
            // Pre-select the standard NMRA decoder
            _selectedFile = new(
                FileName: "0-NMRAMaxStandardDecoder.json",
                Name: "NMRA Maximal Standard Decoder (" + Localizer["SystemDef"] + ")",
                Manufacturer: "NMRA",
                Location: DecoderFileLocation.Application
                );
            return true;
        }
    }

    /// <summary>
    /// Load the decoder definition file for the selected decoder and
    /// setup the CV definitions and tabs based on that decoder definition file.
    /// </summary>
    /// <returns></returns>
    private async Task LoadSelectedDecoderFile()
    {
        if (_selectedFile is not null)
        {
            await ReadDecoderDef(_selectedFile);
        }
        await SetupTabs();
        await Parent.NotifyStateChanged();
        StateHasChanged();
    }

    /// <summary>
    /// Event handler, triggered when the user clicks on a decoder in the list.
    /// </summary>
    /// <param name="decoder"></param>
    private async Task OnFileSelected(DecoderListItemDto decoder)
    {
        //_tempSelectedFile = decoder;
        var t = "hov";
    }

    /// <summary>
    /// Reads the decoder definition file for the selected decoder
    /// and sets the CV definitions from that file into the DecoderSettings.
    /// </summary>
    /// <param name="decoder"></param>
    /// <returns></returns>
    private async Task ReadDecoderDef(DecoderListItemDto decoder)
    {
        // Remove tabs associated with the previous selected decoder:
        foreach (var onePage in DecoderSettings.Pages)
        {
            _ = Parent.RemoveTabById(onePage.Id);
        }

        // Read the decoder definition file:
        var result = await DecoderDefinitionService.GetLocoDecoderDefAndSetCVsIntoSettings(decoder, DecoderSettings);
        if (result.IsSuccess is false)
        {
            foreach (var errorMessageForField in result.Messages)
            {
                foreach (var errorMessage in errorMessageForField.Messages)
                {
                    if (string.IsNullOrEmpty(errorMessage) is false)
                    {
                        ErrorMessages.Add(errorMessage);
                        await ErrorMessagesChanged.InvokeAsync(ErrorMessages);
                    }
                }
            }
            return;
        }

        ProgTargetAddr.LocoAddress = DecoderSettings.GetLocoAddress();
    }

    private async Task SetupTabs()
    {
        // Setup the tabs associated with the selected decoder
        UIPagesAddPagesParams parms = new(
            Parent: Parent,
            DecoderSettings: DecoderSettings,
            ProgTarget: ProgTargetAddr.ProgTarget,
            LocoAddress: (ushort?)ProgTargetAddr.LocoAddress,
            ErrorMessages: ErrorMessages,
            ErrorMessagesChanged: ErrorMessagesChanged,
            WorkingMessage: WorkingMessage,
            WorkingMessageChanged: WorkingMessageChanged,
            SuccessMessage: SuccessMessage,
            SuccessMessageChanged: SuccessMessageChanged
        );

        var result = await DecoderUIPageBuilder.AddPages(parms);
        if (result.IsSuccess is false)
        {
            foreach (var errorMessageForField in result.Messages)
            {
                foreach (var errorMessage in errorMessageForField.Messages)
                {
                    if (string.IsNullOrEmpty(errorMessage) is false)
                    {
                        ErrorMessages.Add(errorMessage);
                        await ErrorMessagesChanged.InvokeAsync(ErrorMessages);
                    }
                }
            }
            return;
        }
    }

    /// <summary>
    /// Saves the selected decoder file to the local storage folder for loco decoders,
    /// so that the user can edit that file and have it available in the list of decoders
    /// as a user defined decoder. If the selected decoder is already in the local storage
    /// folder then it will be overwritten with the version from the application folder.
    /// This allows the user to start with a copy of an existing decoder definition and
    /// then edit that copy to create a new user defined decoder.
    /// </summary>
    /// <returns></returns>
    private async Task SaveSelectedDecoderAsLocal()
    {
        await BlankMessages();

        _dashboardSettings = await GetSettingsAsync();

        if (Directory.Exists(_dashboardSettings.LocalLocoDecoderFolder))
        {
            // Since we need to be able to retrieve the decoder definitions files easily later on, we check if the
            // user have navigated away from the specified folde. In that case, we issue an error and ask again.
            bool folderIsValid = false;
            string? fullFilename = null;
            string decoderFilename = _selectedFile!.FileName;
            while (folderIsValid is false)
            {
                fullFilename = await FileAndFolderService.FileSaveAsAsync(_dashboardSettings.LocalLocoDecoderFolder, decoderFilename);
                if (string.IsNullOrEmpty(fullFilename))
                {
                    // User cancelled the file save dialog, so we exit the method without doing anything.
                    return;
                }

                var pathOfSelectedFile = Path.GetDirectoryName(fullFilename);
                decoderFilename = Path.GetFileName(fullFilename);
                if (pathOfSelectedFile != _dashboardSettings.LocalLocoDecoderFolder)
                {
                    var page = Application.Current?.Windows[0].Page;
                    if (page is not null)
                    {
                        await page.DisplayAlertAsync(Localizer["Error"], string.Format(Localizer["OtherFolderNotAllowed"], _dashboardSettings.LocalLocoDecoderFolder), Localizer["OK"]);
                    }
                    else
                    {
                        await JSRuntime.InvokeVoidAsync("alert", $"{Localizer["Error"]}\n{string.Format(Localizer["OtherFolderNotAllowed"], _dashboardSettings.LocalLocoDecoderFolder)}");
                    }
                }
                else
                {
                    folderIsValid = true;
                }
            }

            if (fullFilename is not null && _selectedFile is not null)
            {
                if (_selectedFile.Location is DecoderFileLocation.Application)
                {
                    try
                    {
                        using var stream = await FileSystem.OpenAppPackageFileAsync(@".\LocoDecoders\" + _selectedFile.FileName);
                        using var outputStream = new FileStream(fullFilename, FileMode.Create, FileAccess.Write);
                        await stream.CopyToAsync(outputStream);
                        stream.Close();
                        outputStream.Close();

                        await SetCopiedDecoderFileAsSelected(_selectedFile, fullFilename);

                        await GetAvailableDecodersAsync();

                        await LoadSelectedDecoderFile();
                    }
                    catch (Exception ex)
                    {
                        ErrorMessages.Add(Localizer["ErrorCopyingFile"] + ": " + ex.Message);
                        await ErrorMessagesChanged.InvokeAsync(ErrorMessages);
                    }
                }
                else
                {
                    var fullFromFilename = Path.Combine(_dashboardSettings.LocalLocoDecoderFolder, _selectedFile.FileName);

                    if (string.Compare(fullFromFilename, fullFilename, StringComparison.OrdinalIgnoreCase) == 0)
                    {
                        ErrorMessages.Add(Localizer["FromAndToFileAreTheSame"]);
                        await ErrorMessagesChanged.InvokeAsync(ErrorMessages);
                        return;
                    }

                    if (File.Exists(fullFromFilename) is false)
                    {
                        ErrorMessages.Add(Localizer["FromFileDoesNotExist"]);
                        await ErrorMessagesChanged.InvokeAsync(ErrorMessages);
                        return;
                    }

                    try
                    {
                        string fileName = Path.GetFileName(fullFilename);
                        string destinationPath = Path.Combine(_dashboardSettings.LocalLocoDecoderFolder, fileName);

                        File.Copy(fullFromFilename, destinationPath, overwrite: true);

                        await SetCopiedDecoderFileAsSelected(_selectedFile, fullFilename);

                        await GetAvailableDecodersAsync();

                        await LoadSelectedDecoderFile();
                    }
                    catch (Exception ex)
                    {
                        ErrorMessages.Add(Localizer["ErrorCopyingFile"] + ": " + ex.Message);
                        await ErrorMessagesChanged.InvokeAsync(ErrorMessages);
                    }
                }
            }
        }
        else
        {
            ErrorMessages.Add(Localizer["DirDoesNotExists"]);
            await ErrorMessagesChanged.InvokeAsync(ErrorMessages);
        }
    }

    /// <summary>
    /// Set the _selectedFile field to the just copied decoder file.
    /// </summary>
    /// <param name="originalSelectedFile"></param>
    /// <param name="fullFilename"></param>
    /// <returns></returns>
    private async Task SetCopiedDecoderFileAsSelected(DecoderListItemDto originalSelectedFile, string fullFilename)
    {
        DecoderFileRootDto? decoderFile = await DecoderDefinitionService.GetMetaInfoFromLocalLocoDecoderFile(fullFilename);

        _selectedFile = new(
            FileName: Path.GetFileName(fullFilename),
            Name: decoderFile!.Meta.Model + $" ({Localizer["UserDef"]})",
            Manufacturer: originalSelectedFile.Manufacturer,
            Location: DecoderFileLocation.LocalStorage
        );
    }

    private async Task<DashboardSettings> GetSettingsAsync()
    {
        return await DashboardStateService.GetSettingsAsync();
    }

    /// <summary>
    /// Gives a warning when a new decoder definition file is to be loaded.
    /// This gives the user the option to save the changes to the current
    /// decoder definition before it gets overridden by the new decoder definition,
    /// provided that the decoder file is a user defined decoder file (i.e. located
    /// in the local storage folder) and that there are changes to save.
    /// </summary>
    /// <returns></returns>
    private async Task LoadAndSetupForDecoder()
    {
        await BlankMessages();

        if (DecoderSettings.IsChanged() && _selectedFile?.Location is DecoderFileLocation.LocalStorage)
        {
            // Dialog Do you want to save before override.
            var page = Application.Current?.Windows[0].Page;
            bool saveBeforeLoad = false;
            if (page is not null)
            {
                // "You have made changes to your decoder. Do you want to save them, before loading the selected decoder?"
                saveBeforeLoad = await page.DisplayAlertAsync(Localizer["Decoder"], Localizer["DecoderChangedWantToSave"], Localizer["Yes"], Localizer["No"]);
            }
            else
            {
                saveBeforeLoad = await JSRuntime.InvokeAsync<bool>("confirm", $"{Localizer["Warning"]}\n{Localizer["DecoderChangedWantToSave"]}");
            }

            if (saveBeforeLoad)
            {
                await DecoderDefinitionService.SaveValuesToUserDefinedLocoDecoderAsync(_selectedFile!, DecoderSettings);
            }
        }

        await ReadDecoderDef(_selectedFile!);
        await SetupTabs();
    }

    /// <summary>
    /// Clear error and status messages
    /// </summary>
    private async Task BlankMessages()
    {
        ErrorMessages.Clear();
        await ErrorMessagesChanged.InvokeAsync(ErrorMessages);
        WorkingMessage = null;
        await WorkingMessageChanged.InvokeAsync(WorkingMessage);
        SuccessMessage = null;
        await SuccessMessageChanged.InvokeAsync(SuccessMessage);
        StateHasChanged();
    }

    /// <summary>
    /// Handle edit action for a locomotive.
    /// </summary>
    private async Task OnLocoEdit(LocomotiveListItemDto locomotive)
    {
        try
        {
            await BlankMessages();
            WorkingMessage = "Loading locomotive for editing...";
            await WorkingMessageChanged.InvokeAsync(WorkingMessage);
            StateHasChanged();

            // Load the locomotive data from the file
            var result = await LocoDefinitionService.GetLocomotiveAsync(locomotive.FilePath);
            if (!result.IsSuccess)
            {
                if (result.Messages.Count > 0)
                {
                    List<string> lstErrorMessages = [];
                    foreach (var fileMessages in result.Messages)
                    {
                        lstErrorMessages.AddRange(fileMessages.Messages);
                    }

                    ErrorMessages.AddRange(lstErrorMessages);
                    await ErrorMessagesChanged.InvokeAsync(lstErrorMessages);
                }
                return;
            }
            _newLocomotive = result.Data;

            if (_newLocomotive is not null)
            {
                _isEditMode = true;
                _editingFilePath = locomotive.FilePath;
                _showAddLocomotiveModal = true;
                StateHasChanged();
                SuccessMessage = null;
                await SuccessMessageChanged.InvokeAsync(SuccessMessage);
            }
            else
            {
                ErrorMessages.Add($"Failed to load locomotive data from '{locomotive.FilePath}'");
                await ErrorMessagesChanged.InvokeAsync(ErrorMessages);
            }
        }
        catch (Exception ex)
        {
            ErrorMessages.Add($"Error editing locomotive: {ex.Message}");
            await ErrorMessagesChanged.InvokeAsync(ErrorMessages);
            Logger.LogError(ex, "Error editing locomotive");
        }
        finally
        {
            WorkingMessage = null;
            await WorkingMessageChanged.InvokeAsync(WorkingMessage);
        }
    }

    /// <summary>
    /// Handle delete action for a locomotive.
    /// </summary>
    private async Task OnLocoDelete(LocomotiveListItemDto locomotive)
    {
        try
        {
            await BlankMessages();

            var page = Application.Current?.Windows[0].Page;
            bool confirmDelete = false;
            if (page is not null)
            {
                confirmDelete = await page.DisplayAlertAsync(
                    "Delete Locomotive",
                    $"Are you sure you want to delete '{locomotive.Name}'?",
                    "Delete",
                    "Cancel"
                );
            }
            else
            {
                confirmDelete = await JSRuntime.InvokeAsync<bool>("confirm", $"Are you sure you want to delete '{locomotive.Name}'?");
            }

            if (confirmDelete && !string.IsNullOrEmpty(locomotive.FilePath))
            {
                WorkingMessage = "Deleting locomotive...";
                await WorkingMessageChanged.InvokeAsync(WorkingMessage);
                StateHasChanged();

                var result = await LocoDefinitionService.DeleteLocomotiveFileAsync(locomotive.FilePath);
                if (result.IsSuccess)
                {
                    await LoadLocomotivesFromFilesAsync();
                    SuccessMessage = $"Locomotive '{locomotive.Name}' deleted successfully.";
                    await SuccessMessageChanged.InvokeAsync(SuccessMessage);
                    StateHasChanged();
                    
                }
                else
                {
                    if (result.Messages.Count > 0)
                    {
                        List<string> lstErrorMessages = [];
                        foreach (var fileMessages in result.Messages)
                        {
                            lstErrorMessages.AddRange(fileMessages.Messages);
                        }
                        ErrorMessages.AddRange(lstErrorMessages);
                        await ErrorMessagesChanged.InvokeAsync(lstErrorMessages);
                    }
                }
            }
        }
        catch (Exception ex)
        {
            ErrorMessages.Add($"Error deleting locomotive: {ex.Message}");
            await ErrorMessagesChanged.InvokeAsync(ErrorMessages);
            Logger.LogError(ex, "Error deleting locomotive");
        }
        finally
        {
            WorkingMessage = null;
            await WorkingMessageChanged.InvokeAsync(WorkingMessage);
            StateHasChanged();
        }
    }

    /// <summary>
    /// Handle add new locomotive action.
    /// </summary>
    private async Task OnAddNewLoco()
    {
        try
        {
            await BlankMessages();

            // Initialize a new locomotive with default decoder configuration
            _newLocomotive = new LocomotiveDefinitionDto
            {
                Meta = new LocomotiveMetaDto
                {
                    Name = string.Empty,
                    ShortName = null,
                    Manufacturer = null,
                    CatalogueNumber = null,
                    Class = null,
                    UnitNumber = null,
                    Description = null,
                    Purchased = null,
                    PurchasePrice = null,
                    Remarks = null,
                    Modifications = null
                },
                Decoder = new LocomotiveDecoderDto
                {
                    Address = 0
                }
            };

            // Open the modal
            _showAddLocomotiveModal = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            ErrorMessages.Add($"Error opening add locomotive dialog: {ex.Message}");
            await ErrorMessagesChanged.InvokeAsync(ErrorMessages);
            Logger.LogError(ex, "Error opening add locomotive dialog");
        }
    }

    /// <summary>
    /// Save the new locomotive to a JSON file and refresh the list.
    /// </summary>
    private async Task SaveNewLocomotiveClick()
    {
        if (_newLocomotive?.Meta is not null)
        {
            await SaveNewLocomotive();
        }
    }

    /// <summary>
    /// Validate and save the locomotive to a JSON file (handles both add and edit modes).
    /// </summary>
    private async Task SaveNewLocomotive()
    {
        try
        {
            await BlankMessages();

            var result = await LocoDefinitionService.SaveLocomotiveAsync(_newLocomotive!);
            if (!result.IsSuccess)
            {
                if (result.Messages.Count > 0)
                {
                    List<string> lstErrorMessages = [];
                    foreach (var fileMessages in result.Messages)
                    {
                        lstErrorMessages.AddRange(fileMessages.Messages);
                    }
                    ErrorMessages.AddRange(lstErrorMessages);
                    await ErrorMessagesChanged.InvokeAsync(lstErrorMessages);
                }
                StateHasChanged();
                return;
            }

            // Reload the locomotives list
            await LoadLocomotivesFromFilesAsync();

            // Store the locomotive name for the success message before clearing
            string locoName = _newLocomotive!.Meta.Name ?? "Unknown";

            // Close the modal
            _showAddLocomotiveModal = false;
            _newLocomotive = null;
            _isEditMode = false;
            _editingFilePath = string.Empty;

            string action = _isEditMode ? "updated" : "added";
            SuccessMessage = $"Locomotive '{locoName}' {action} successfully.";
            await SuccessMessageChanged.InvokeAsync(SuccessMessage);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            ErrorMessages.Add($"Error saving locomotive: {ex.Message}");
            await ErrorMessagesChanged.InvokeAsync(ErrorMessages);
            Logger.LogError(ex, "Error saving locomotive");
        }
        finally
        {
            WorkingMessage = null;
            await WorkingMessageChanged.InvokeAsync(WorkingMessage);
        }
    }

    /// <summary>
    /// Cancel adding/editing a locomotive and close the modal.
    /// </summary>
    private async Task CancelAddLocomotive()
    {
        _showAddLocomotiveModal = false;
        _newLocomotive = null;
        _isEditMode = false;
        _editingFilePath = string.Empty;
        await BlankMessages();
        StateHasChanged();
    }

}
