@*
    LocoDecoderList.razor
    This component is used to read the manufacturer information from a loco decoder and to show
    that information to the user.

    Further, the component shows a list of loco decoder definition files that are available in the system and allows
    the user to select one of those files to use for programming the loco decoder. The component also allows the
    user to save a copy of the selected decoder definition file to a local storage folder, so that the user can edit
    that file and have it available in the list of decoders as a user defined decoder.

    Unfortunately there is no standard way to read the decoder type and version from a loco decoder,
    so this component just read the manufacturer id and the Cv 7 for the version.
*@
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Logging
@using Microsoft.JSInterop
@using Microsoft.Maui.Controls
@using Z21Client.Models
@using Z21Dashboard.Application.Interfaces
@using Z21Dashboard.Application.Models
@using Z21Dashboard.Helpers
@using Z21Dashboard.LocomotiveDecoders.Interfaces
@using Z21Dashboard.LocomotiveDecoders.Models
@using Z21Dashboard.NmraDccStandard
@using Z21Dashboard.Ui.Components
@using Z21Dashboard.Ui.Dashboard.Components
@using Z21Dashboard.Ui.Interfaces
@using Z21Dashboard.Ui.Models
@inject IDashboardStateService DashboardStateService
@inject IDecoderUIPageBuilder DecoderUIPageBuilder
@inject IDecoderDefinitionService DecoderDefinitionService
@inject IDecoderProgHelperService DecoderProgHelperService
@inject IDecoderTabsManagement DecoderTabsManagement
@inject IFileAndFolderService FileAndFolderService
@inject IJSRuntime JSRuntime
@inject ILogger<LocoDecoderList> Logger
@inject IStringLocalizer<LocoDecoderListResources> Localizer

<div class="row mb-2 align-items-center">
    <div class="col-3">
        <label>@Localizer["Manufacturer"]:</label>
    </div>
    <div class="col-2">
        <div class="form-control form-control-sm">
            @_manufacturerCode
        </div>
    </div>
    <div class="col-7">
        <div class="form-control form-control-sm">
            @_manufacturerName
        </div>
    </div>
</div>

<div class="row mb-2 align-items-center">
    <div class="col-3">
        <label>@Localizer["VersionNumber"]:</label>
    </div>
    <div class="col-9">
        <div class="form-control form-control-sm">
            @_manufacturerVersionNbr
        </div>
    </div>
</div>

@if (_displayZimoDecoderModel)
{
    <div class="row mb-2 align-items-center">
        <div class="col-3">
            <label>@Localizer["ZIMODecoderModel"]:</label>
        </div>
        <div class="col-9">
            <div class="form-control form-control-sm">
                @_zimoDecoderModel
            </div>
        </div>
    </div>
}

@if (_displayEsuDecoderModel)
{
    <div class="row mb-2 align-items-center">
        <div class="col-3">
            <label>@Localizer["ESUDecoderModel"]:</label>
        </div>
        <div class="col-9">
            <div class="form-control form-control-sm">
                @_esuDecoderModel
            </div>
        </div>
    </div>
}

<div class="row mb-2">
    <div class="col-12 d-flex justify-content-end gap-2">
        <button type="button" class="btn btn-primary" disabled="@_buttonsDisabled"
                @onclick="@(async () => await GetManufacturerAsync())" aria-label="ReadCV">
            @Localizer["ReadFromLocoDecoder"]
        </button>
    </div>
</div>

<hr />

@if (_decoderDoesNotSupportRailCom)
{
    <div class="alert alert-info py-2 mb-3">@Localizer["DecoderNoRailCom"]</div>
}

<div class="row mb-2 align-text-top">
    <div class="col-3">
        <label>@Localizer["Decoders"]:</label>
    </div>
    <div class="col-9">
        <ItemList TItem="DecoderListItemDto"
                  Items="@_listOfLocoDecoders"
                  Height="180px"
                  EmptyText="@Localizer["NoDecoderMatch"]"
                  @bind-SelectedItem="@_selectedFile"
                  GroupKeySelector='c => $"{c.ManufacturerId} - {c.Manufacturer}"'
                  DisplayKey="false"
                  KeySelector="f => f.FileName"
                  DisplaySelector="f => f.Name"
                  SearchPlaceholder="@Localizer["SearchInfo"]"
                  SearchSelectors="@(new Func<DecoderListItemDto,string>[] { c => $"{c.ManufacturerId} - {c.Manufacturer}", c => c.Name})">
        </ItemList>
    </div>
</div>

<div class="row">
    <div class="col-12 d-flex justify-content-end gap-2">
        @if (string.IsNullOrEmpty(_dashboardSettings.LocalLocoDecoderFolder) is false &&
            DecoderRequestParent is DecoderRequestParent.Decoder)
        {
            <button type="button" class="btn btn-primary"
                    @onclick="@(async () => await SaveSelectedDecoderAsLocalAsync())" aria-label="@Localizer["SaveSelectedDecoderAsLocal"]">
                @Localizer["SaveSelectedDecoderAsLocal"]
            </button>
        }
        @if (string.IsNullOrEmpty(_dashboardSettings.LocalLocoDecoderFolder) is false &&
            DecoderRequestParent is DecoderRequestParent.Decoder &&
            DecoderSettings.DecoderFileLocation is DecoderFileLocation.LocalStorage
            )
        {
            <button type="button" class="btn btn-primary"
                    @onclick="@(async () => await SaveCurrentDecoderAsync())" aria-label="ReadCV">
                @Localizer["Save"]@GetChangesIndicator()
            </button>
        }
        <button type="button" class="btn btn-primary" disabled="@_buttonsDisabled"
                @onclick="@(async () => await LoadAndSetupForDecoderAsync())" aria-label="ReadCV">
            @if (DecoderRequestParent is DecoderRequestParent.Decoder)
            {
                @Localizer["ReadSelectedDecoder"]
            }
            else
            {
                @Localizer["UseSelectedDecoder"]
            }
        </button>
    </div>
</div>

<DraggableModal IsOpen="_displaySaveAs"
                Title="@Localizer["SaveAs"]"
                OnClose="@(() => _displaySaveAs = false)"
                Height="500px">
    <Content>
        <FileSaveAsDialog InitialFolder="@_dashboardSettings.LocalLocoDecoderFolder"
                          SuggestedFilename="@_suggestedDecoderFilename"
                          RestrictFolderChange="true"
                          OnFileSelected="@(async (filename) => await OnButtonClickInSaveDialogAsync(filename))" />
    </Content>
    <FooterContent>
    </FooterContent>
</DraggableModal>


