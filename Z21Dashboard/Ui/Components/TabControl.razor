@*
  TabControl.razor
  Provides a tab control with a number of tabs. When the
  tabs is longer that the current view, two scroll buttons
  are automatically added.
*@
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Localization
@using Microsoft.JSInterop
@using Z21Dashboard.Ui.Models
@inject IJSRuntime JS
@inject IStringLocalizer<TabControlResource> Localizer

<div class="tabs-container">
    <div class="tabs-header">
        <div class="tabs-scroll" @ref="TabsScrollRef">
            <ul class="nav-tabs">
                @foreach (var tab in Pages)
                {
                    <li class="@(ActiveTab == tab ? "active" : string.Empty)"
                        @onclick="() => ActivateTab(tab)">
                        @tab.Title
                    </li>
                }
            </ul>
        </div>

        <button class="scroll-btn right" type="button" style="display:@(ShowScrollButtons ? "inline-block" : "none")"
        @onclick="ScrollLeft" title="@Localizer["ToolTipLeft"]">&#9664;</button>
        <button class="scroll-btn right" type="button" style="display:@(ShowScrollButtons ? "inline-block" : "none")"
        @onclick="ScrollRight" title="@Localizer["ToolTipRight"]">&#9654;</button>
    </div>

    <div class="tab-content">
        <CascadingValue Value="this">
            @ActiveTab?.Content
        </CascadingValue>
        <CascadingValue Value="this">
            @ChildContent
        </CascadingValue>
    </div>
</div>

@*
    The purpose of these JavaScripts are to scroll the tab header left or right when the respective
    buttons are clicked, and to check if the tab header is overflowing (i.e., if the total width of
    the tabs exceeds the visible area) to determine whether to show the scroll buttons.
*@
<script>
    window.tabControlScroll = window.tabControlScroll || {};
    window.tabControlScroll.scrollBy = function (element, amount) {
        if (!element) return;
        element.scrollBy({ left: amount, behavior: 'smooth' });
    };

    window.tabControlScroll.isOverflowing = function (scrollElement) {
        if (!scrollElement) return false;
        return scrollElement.scrollWidth > scrollElement.clientWidth;
    };
</script>

@code {
    [Parameter]
    public required RenderFragment ChildContent { get; set; }

    [Parameter]
    public EventCallback<ushort>? OnPageChange { get; set; }

    [Parameter]
    public EventCallback OnNotifyStateChange { get; set; }

    public List<TabPageDefinition> Pages = new();
    private TabPageDefinition? ActiveTab;

    private bool ShowScrollButtons = false;
    private ElementReference TabsScrollRef;
    private bool _hasComponentBeenrendered = false;

    private bool _needsMeasure;

    /// <summary>
    /// Force an update.
    /// </summary>
    public async Task NotifyStateChangedAsync()
    {
        await OnNotifyStateChange.InvokeAsync();
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _hasComponentBeenrendered = true;
        if ((_needsMeasure || firstRender) && Pages.Count > 0)
        {
            _needsMeasure = false;
            // Vent én render-cyklus så DOM er opdateret
            await Task.Yield();
            ShowScrollButtons = await JS.InvokeAsync<bool>("tabControlScroll.isOverflowing", TabsScrollRef);
            StateHasChanged();
        }
    }

    /// <summary>
    /// Runtime tabs registration. Can be used to add tabs dynamically
    /// after the component has been rendered.
    /// </summary>
    /// <param name="tab"></param>
    /// <returns></returns>
    public async ValueTask AddPage(TabPageDefinition tab)
    {
        await RegisterPage(tab);
        _needsMeasure = true;
        StateHasChanged();
    }

    /// <summary>
    /// Looks for a page by it's id and set it active.
    /// </summary>
    /// <param name="id"></param>
    /// <returns></returns>
    public async ValueTask SetActivePageByIdAsync(string id)
    {
        var tab = Pages.FirstOrDefault(t => t.Id == id);
        if (tab is not null)
        {
            ActivateTab(tab);
        }
    }

    /// <summary>
    /// Remove a tab page. If the removed tab is the active one,
    /// the first remaining tab will be activated.
    /// </summary>
    /// <param name="tab"></param>
    public void RemovePage(TabPageDefinition tab)
    {
        if (Pages.Remove(tab))
        {
            if (ActiveTab == tab)
                ActiveTab = Pages.FirstOrDefault();
            StateHasChanged();
        }
    }

    /// <summary>
    /// Remove tab page by id.
    /// </summary>
    /// <param name="id"></param>
    /// <returns></returns>
    public bool RemoveTabById(string id)
    {
        var tab = Pages.FirstOrDefault(t => t.Id == id);
        if (tab is not null)
        {
            RemovePage(tab);
            return true;
        }
        return false;
    }

    /// <summary>
    /// Compile-time (TabPage) registrering
    /// </summary>
    /// <param name="tab"></param>
    /// <returns></returns>
    public async ValueTask RegisterPage(TabPageDefinition tab)
    {
        // Check if this pageid already exists
        if (string.IsNullOrEmpty(tab.Id) is false &&
            Pages.FirstOrDefault(x => x.Id == tab.Id) is not null)
        {
            return;
        }

        Pages.Add(tab);

        if (ActiveTab is null)
            ActiveTab = tab;

        if (_hasComponentBeenrendered is true)
        {
            // Vent én render-cyklus så DOM er opdateret
            await Task.Yield();
            ShowScrollButtons = await JS.InvokeAsync<bool>("tabControlScroll.isOverflowing", TabsScrollRef);
            StateHasChanged();
        }
    }


    /// <summary>
    /// Sets the specified tab as active and triggers
    /// the OnPageChange event with the new active tab index.
    /// </summary>
    /// <param name="tab"></param>
    private void ActivateTab(TabPageDefinition tab)
    {
        ActiveTab = tab;

        var index = Pages.IndexOf(tab);
        OnPageChange?.InvokeAsync((ushort)index);

        StateHasChanged();
    }

    /// <summary>
    /// Call the JavaScript.
    /// </summary>
    /// <returns></returns>
    private async Task ScrollLeft()
    {
        await JS.InvokeVoidAsync("tabControlScroll.scrollBy", TabsScrollRef, -150);
    }

    /// <summary>
    /// Call the JavaScript.
    /// </summary>
    /// <returns></returns>
    private async Task ScrollRight()
    {
        await JS.InvokeVoidAsync("tabControlScroll.scrollBy", TabsScrollRef, 150);
    }
}
