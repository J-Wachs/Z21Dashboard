@*
    DataGrid.razor
    A light-weight grid component to display a set of fields
    and allows the user to select records and click on
    action buttons.
*@
@using System.Collections.Generic
@using System.Linq
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Z21Dashboard.Ui.Models
@typeparam TItem

<div class="datagrid-wrapper">
    @* SEARCH FIELD (optional) *@
    @if (ShowSearch)
    {
        <div class="datagrid-search-container mb-1">
            <input class="datagrid-search form-control form-control-sm"
                   placeholder="@SearchPlaceholder"
                   @bind="SearchText"
                   @bind:event="oninput" />
        </div>
    }

    @* TABLE *@
    <div class="datagrid-container">
        <table class="table table-striped table-hover datagrid-table">
            <thead>
                <tr>
                    @foreach (var column in Columns ?? new List<ColumnDefinition<TItem>>())
                    {
                        <th style="@(string.IsNullOrEmpty(column.Width) ? string.Empty : $"width: {column.Width};")"
                            class="@column.CellCssClass">
                            @column.Header
                        </th>
                    }
                    @if (RowActionsTemplate is not null)
                    {
                        <th style="width: 120px; text-align: center;">Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (FilteredItems?.Any() == true)
                {
                    @foreach (var item in FilteredItems)
                    {
                        var match = EqualityComparer<TItem>.Default.Equals(item, SelectedItem);
                        <tr class="datagrid-row @(match ? "selected" : string.Empty)"
                            @onclick="() => SelectRow(item)"
                            style="cursor: pointer;">
                            @foreach (var column in Columns ?? new List<ColumnDefinition<TItem>>())
                            {
                                var cellValue = column.ValueSelector(item);
                                <td style="@(string.IsNullOrEmpty(column.Width) ? string.Empty : $"width: {column.Width};")"
                                    class="@column.CellCssClass"
                                    align="@column.Alignment">
                                    @(cellValue?.ToString() ?? string.Empty)
                                </td>
                            }
                            @if (RowActionsTemplate is not null)
                            {
                                <td style="width: 120px; text-align: center;">
                                    @RowActionsTemplate(item)
                                </td>
                            }
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="@((Columns?.Count ?? 0) + (RowActionsTemplate is not null ? 1 : 0))" 
                            class="text-center text-muted py-4">
                            @EmptyMessage
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public IEnumerable<TItem>? Items { get; set; }

    [Parameter]
    public List<ColumnDefinition<TItem>>? Columns { get; set; }

    [Parameter]
    public RenderFragment<TItem>? RowActionsTemplate { get; set; }

    [Parameter]
    public TItem? SelectedItem { get; set; }

    [Parameter]
    public EventCallback<TItem?> SelectedItemChanged { get; set; }

    [Parameter]
    public EventCallback<TItem> OnRowClicked { get; set; }

    [Parameter]
    public bool ShowSearch { get; set; } = false;

    [Parameter]
    public string SearchPlaceholder { get; set; } = "Search...";

    [Parameter]
    public Func<TItem, string>[]? SearchSelectors { get; set; }

    [Parameter]
    public string EmptyMessage { get; set; } = "No items to display";

    private string SearchText { get; set; } = string.Empty;

    private IEnumerable<TItem> FilteredItems
    {
        get
        {
            var items = Items ?? Enumerable.Empty<TItem>();

            if (string.IsNullOrWhiteSpace(SearchText) || SearchSelectors?.Length == 0)
                return items;

            return items.Where(item =>
                SearchSelectors?.Any(sel =>
                    sel(item).Contains(SearchText, StringComparison.OrdinalIgnoreCase)) ?? false
            );
        }
    }

    /// <summary>
    /// Event handler for when a row is selected.
    /// </summary>
    /// <param name="item"></param>
    /// <returns></returns>
    private async Task SelectRow(TItem item)
    {
        SelectedItem = item;
        await SelectedItemChanged.InvokeAsync(item);
        await OnRowClicked.InvokeAsync(item);
    }
}
