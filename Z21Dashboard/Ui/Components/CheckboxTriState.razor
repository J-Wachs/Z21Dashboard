@*
    CheckBoxTriState.razor
    A CheckBox control that can show and handle the three states
    of a nullable-bool variable.

    The three states (values) are called:
    - True
    - False
    - Indetermined

    The mapped value vil contine one of the values:
    - true
    - false
    - null
*@
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@inject IJSRuntime JS

<input @ref="elementRef"
       type="checkbox"
       checked="@(Checked is true)"
       @onclick="HandleClick"
       @attributes=AdditionalAttributes />

<script>
    function setCheckboxState(element, isChecked, isIndeterminate, tooltip) {
        element.checked = isChecked;
        element.indeterminate = isIndeterminate;
        element.title = tooltip;
    }
</script>

@code {
    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }

    [Parameter]
    public bool? Checked { get; set; }

    [Parameter]
    public EventCallback<bool?> CheckedChanged { get; set; }

    [Parameter]
    public string TrueTooltip { get; set; } = string.Empty;

    [Parameter]
    public string FalseTooltip { get; set; } = string.Empty;

    [Parameter]
    public string IndeterminateTooltip { get; set; } = string.Empty;

    private ElementReference elementRef;
    private bool _needsUpdate;

    private string CurrentTooltip => Checked switch
    {
        true => TrueTooltip,
        false => FalseTooltip,
        null => IndeterminateTooltip
    };

    protected override void OnParametersSet()
    {
        _needsUpdate = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_needsUpdate)
        {
            _needsUpdate = false;

            await JS.InvokeVoidAsync(
                "setCheckboxState",
                elementRef,
                Checked == true,
                Checked == null,
                CurrentTooltip
            );
        }
    }

    /// <summary>
    /// Event hander triggered when the checkbox is clicked.
    /// To be albe to control the three states, the values
    /// rotate between True, False and null.
    /// </summary>
    /// <param name="e"></param>
    /// <returns></returns>
    private async Task HandleClick(MouseEventArgs e)
    {
        bool? next = Checked switch
        {
            false => true,
            true => null,
            null => false
        };

        await CheckedChanged.InvokeAsync(next);

        // optional immediate UI sync (undgår blink)
        await JS.InvokeVoidAsync(
            "setCheckboxState",
            elementRef,
            next == true,
            next == null,
            next switch
            {
                true => TrueTooltip,
                false => FalseTooltip,
                null => IndeterminateTooltip
            }
        );
    }
}
